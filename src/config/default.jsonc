{
  // Select models by ID, or provider/model-id. A provider scopes bare IDs.
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek-flash",
  "defaultPrompt": "sample_prompt",
  // "defaultThinkingLevel": "low", // Arbitrary reasoning_effort string; default low.
  "logLevel": "INFO",
  "providers": {
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api/v1",
      // Run: aichat config login --provider openrouter
      // "apiKey": { "value": "your-key", "encryption": "" }, // Omit for unauthenticated services.
      // Login writes { "value": "v1:...", "encryption": "generated-passphrase" }.
      // "name": "My gateway", // Defaults to provider key.
      // "api": "openai-completions", // Only supported API; default.
      // "headers": { "X-Organization": "my-team", "X-Token": "${GATEWAY_TOKEN}" },
      // Header values accept $NAME, ${NAME}, or !command (trusted config only).
      // Commands run on request, time out after 10s, and cache successes in process.
      // "queryParams": { "region": "sg" },
      // "timeoutMs": 120000, // Positive request timeout, includes streaming.
      // "maxRetries": 2, // Retries transport failures, 429 and 5xx before streaming.
      // "extraBody": { "temperature": 0.7 }, // Arbitrary request fields.
      "models": [
        {
          "id": "deepseek-flash",
          "stream": true, // Per-model streaming; default true.
          // "name": "DeepSeek Flash", // Defaults to id.
          // "reasoning": true, // Default true; false explicitly requests thinking off (API-specific).
          // "thinkingLevel": "low", // Overrides defaultThinkingLevel.
          // "headers": { "X-Model-Route": "fast" }, // Overrides provider headers.
          // "extraBody": { "temperature": 0.5 }, // Overrides provider fields.
          // "removeBodyFields": ["store"] // Removed last, top-level fields only.
        }
      ]
    }
  },
  "prompts": {
    "sample_prompt": {
      "system": "You are a terminal assistant. Give concise responses in plain text.",
      "user": "{{ input }}"
      // Templates: {{ cwd }}, {{ env(\"LANG\") }}, {{ shell(\"command -v git\") }}.
      // shell runs per request, with a 3s timeout and 64 KiB output limit.
    },
    "concise": { "system": "Use plain text, give extremely concise output" },
    "shell-exec-or-chat": { "system": INTEGRATION_PROMPT }
  },
  // "pure": false,
  // "logLevel": "INFO",
  "display": {
    // "usage": false,
    // "model": false,
    // "prompt": false,
    // "reasoning": false,
    // "duration": false
  }
}
