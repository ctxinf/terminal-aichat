      // "encryption": "generated-passphrase" // value must then be v1 ciphertext.
      // v1: AES-256-GCM + Argon2id; password and ciphertext share this file.
    }
    */
  },
  "prompts": {
    "sample_prompt": {
      "content": "You are a terminal assistant. Give concise responses in plain text."
    },
    "concise": { "content": "Use plain text, give extremely concise output" },
    "shell-exec-or-chat": { "content": INTEGRATION_PROMPT }
  }
